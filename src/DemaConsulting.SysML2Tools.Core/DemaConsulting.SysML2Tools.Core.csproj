<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>DemaConsulting.SysML2Tools.Core</PackageId>
    <AssemblyName>DemaConsulting.SysML2Tools.Core</AssemblyName>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>SysML v2 diagram rendering for .NET</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/demaconsulting/SysML2Tools</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/SysML2Tools</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>sysml2;sysml;mbse;parser</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>SysML2 Tools</Title>
    <Product>DemaConsulting.SysML2Tools</Product>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Suppress NU5104: this library intentionally depends on the pre-release
         DemaConsulting.Rendering.Layout package until it reaches a stable release. -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(Product)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>

    <!-- ApiMark Configuration: generate Markdown API reference docs from the XML doc
         comments (see GenerateDocumentationFile above) and bundle them into the NuGet
         package alongside the assembly. -->
    <ApiMarkPackDocs>true</ApiMarkPackDocs>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.5" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />
    <PackageReference Include="DemaConsulting.ApiMark.MSBuild" Version="0.4.9" PrivateAssets="All" />
    <PackageReference Include="DemaConsulting.Rendering.Layout" Version="0.1.0-beta.2" />
  </ItemGroup>

  <!-- Language and Stdlib are internal (IsPackable=false) projects, so their PrivateAssets="all"
       marking here prevents them from being emitted as NuGet package dependencies. Instead, the
       CopyProjectReferencesToPackage target below embeds their compiled assemblies directly into
       this package's lib folder (see docs/design/introduction.md for details). -->
  <ItemGroup>
    <ProjectReference Include="..\DemaConsulting.SysML2Tools.Language\DemaConsulting.SysML2Tools.Language.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\DemaConsulting.SysML2Tools.Stdlib\DemaConsulting.SysML2Tools.Stdlib.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Embed the Language and Stdlib assemblies (both IsPackable=false) directly into this
       package's lib folder, since they cannot be resolved as separate NuGet dependencies. Also
       embeds their XML doc-comment files alongside the assemblies so Visual Studio IntelliSense
       resolves doc comments for types re-exported from Language/Stdlib (e.g. WorkspaceLoader,
       StdlibProvider) when consumed through this package. -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferencePath)" Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'" />
      <_ProjectReferenceXmlDocs Include="@(ReferencePath->'%(RootDir)%(Directory)%(Filename).xml')"
                                 Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'
                                            and Exists('%(ReferencePath.RootDir)%(ReferencePath.Directory)%(ReferencePath.Filename).xml')" />
      <BuildOutputInPackage Include="@(_ProjectReferenceXmlDocs)" />
    </ItemGroup>
  </Target>

  <!-- Inline task used by CopyLanguageAndStdlibApiDocsToPackage (below) to merge the Language's
       and Stdlib's own namespace-table rows into this project's own generated api.md index, so
       that the folded-in namespace pages are discoverable/linked from the package's natural
       entry point instead of being orphaned files in the api/ tree. Written to no-op safely
       (skip the merge, leave TargetIndexFile unchanged) if the expected table separator or a
       source file is missing, so a future ApiMark output-format change degrades gracefully
       rather than breaking the build. -->
  <UsingTask TaskName="MergeApiMarkNamespaceIndex" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <TargetIndexFile ParameterType="System.String" Required="true" />
      <SourceIndexFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Collections.Generic" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!File.Exists(TargetIndexFile))
        {
            Log.LogMessage("MergeApiMarkNamespaceIndex: target index file not found, skipping merge: " + TargetIndexFile);
            return true;
        }

        var lines = new List<string>(File.ReadAllLines(TargetIndexFile));
        var separatorIndex = lines.FindIndex(l => l.Trim() == "| --- | --- | --- |");
        if (separatorIndex < 0)
        {
            Log.LogMessage("MergeApiMarkNamespaceIndex: namespace table separator not found, skipping merge: " + TargetIndexFile);
            return true;
        }

        var newRows = new List<string>();
        foreach (var sourceItem in SourceIndexFiles)
        {
            var sourceFile = sourceItem.ItemSpec;
            if (!File.Exists(sourceFile))
            {
                continue;
            }

            foreach (var line in File.ReadAllLines(sourceFile))
            {
                if (line.StartsWith("| [", StringComparison.Ordinal))
                {
                    newRows.Add(line);
                }
            }
        }

        if (newRows.Count == 0)
        {
            Log.LogMessage("MergeApiMarkNamespaceIndex: no namespace rows found in source index files, skipping merge.");
            return true;
        }

        lines.InsertRange(separatorIndex + 1, newRows);
        File.WriteAllLines(TargetIndexFile, lines);
        Log.LogMessage("MergeApiMarkNamespaceIndex: merged " + newRows.Count + " namespace row(s) into " + TargetIndexFile);
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Fold the Language and Stdlib projects' ApiMark-generated api/ folders into this package's
       own api/ folder. Language and Stdlib are IsPackable=false and have no nupkg of their own
       (see above), so this is the only way their "getting started" namespaces (Semantic, Parser,
       Stdlib) reach a consumer's browsable API reference docs. Each project's own top-level
       api.md index (a single-assembly summary table) is intentionally excluded from the copy —
       it describes only that project's own namespaces and would collide with, or misleadingly
       duplicate, this project's own api.md index; the per-namespace/per-type Markdown pages
       (which do not collide, since namespaces differ) are copied as-is. After copying, the
       MergeApiMarkNamespaceIndex inline task (above) appends Language's and Stdlib's own
       namespace-table rows into this project's own generated api.md, so that the copied-in
       namespace pages are linked/discoverable from the package's natural entry point rather than
       being orphaned files only reachable by browsing the raw api/ folder tree.
       DependsOnTargets="ResolveReferences" is not required for correctness here (MSBuild already
       guarantees Language/Stdlib finish building — including their own AfterTargets="Build"
       ApiMark step — before this project's Build completes, since they are ProjectReferences),
       but AfterTargets/BeforeTargets below pin this target's ordering relative to ApiMark's own
       generation and pack-inclusion targets; verified end-to-end with a real `dotnet pack`.
       The TFM-restriction condition mirrors ApiMark's own GenerateApiMarkDocumentation/
       _ApiMarkIncludeDocsInPackage targets so this target (copy + index-merge) runs exactly once
       per pack/build, instead of once per inner per-TFM build (which would otherwise race
       multiple concurrent copies/merges against the same destination files). -->
  <Target Name="CopyLanguageAndStdlibApiDocsToPackage"
          Condition="'$(ApiMarkPackDocs)' == 'true'
                 and ('$(TargetFrameworks)' == '' or '$(TargetFramework)' == '$(_ApiMarkPackDocsTargetFramework)')"
          AfterTargets="GenerateApiMarkDocumentation"
          BeforeTargets="_ApiMarkIncludeDocsInPackage">
    <ItemGroup>
      <_LanguageApiDocFiles Include="$(MSBuildThisFileDirectory)..\DemaConsulting.SysML2Tools.Language\api\**\*"
                            Exclude="$(MSBuildThisFileDirectory)..\DemaConsulting.SysML2Tools.Language\api\api.md" />
      <_StdlibApiDocFiles Include="$(MSBuildThisFileDirectory)..\DemaConsulting.SysML2Tools.Stdlib\api\**\*"
                          Exclude="$(MSBuildThisFileDirectory)..\DemaConsulting.SysML2Tools.Stdlib\api\api.md" />
      <_ApiMarkSourceIndexFiles Include="$(MSBuildThisFileDirectory)..\DemaConsulting.SysML2Tools.Language\api\api.md" />
      <_ApiMarkSourceIndexFiles Include="$(MSBuildThisFileDirectory)..\DemaConsulting.SysML2Tools.Stdlib\api\api.md" />
    </ItemGroup>
    <Copy SourceFiles="@(_LanguageApiDocFiles)"
          DestinationFolder="$(ApiMarkOutputDir)\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_LanguageApiDocFiles)' != ''" />
    <Copy SourceFiles="@(_StdlibApiDocFiles)"
          DestinationFolder="$(ApiMarkOutputDir)\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_StdlibApiDocFiles)' != ''" />
    <MergeApiMarkNamespaceIndex TargetIndexFile="$(ApiMarkOutputDir)\api.md"
                                SourceIndexFiles="@(_ApiMarkSourceIndexFiles)" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.SysML2Tools.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies
           in packages that consume this tool.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.301">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.27.0.140913">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
