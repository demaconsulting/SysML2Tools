<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>DemaConsulting.SysML2Tools.Language</PackageId>
    <AssemblyName>DemaConsulting.SysML2Tools.Language</AssemblyName>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>SysML v2 language parser and semantic analysis for .NET</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/demaconsulting/SysML2Tools</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/SysML2Tools</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>sysml2;sysml;mbse;parser;kerml</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>SysML2 Tools Language</Title>
    <Product>DemaConsulting.SysML2Tools</Product>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Suppress errors from ANTLR4-generated code: 1584/1658 (cref keyword syntax), 3021 (CLSCompliant) -->
    <NoWarn>1584;1658;3021</NoWarn>

    <!-- Exclude the ANTLR4-generated grammar/parser/lexer/listener/visitor code-gen namespace
         from ApiMark-generated docs. These thousands of near-duplicate generated-code doc files
         (SysMLv2Lexer, SysMLv2Parser, listener/visitor classes, etc.) provide zero value to
         consumers of the packaged API reference docs. Confirmed working with ApiMark.MSBuild
         0.4.10's native exclude wildcard feature (equivalent to its CLI "exclude" option). -->
    <ApiMarkExclude>DemaConsulting.SysML2Tools.Parser.Antlr*</ApiMarkExclude>

    <!-- ApiMark Configuration: generate Markdown API reference docs from the XML doc
         comments (see GenerateDocumentationFile above) and bundle them into the NuGet
         package alongside the assembly. -->
    <ApiMarkPackDocs>true</ApiMarkPackDocs>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(Product)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.5" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
    <PackageReference Include="Polyfill" Version="11.0.1" PrivateAssets="All" />
    <!-- ApiMark: generate Markdown API reference docs from the XML doc comments (see
         GenerateDocumentationFile above) and bundle them into this project's own NuGet
         package (see ApiMarkPackDocs above). -->
    <PackageReference Include="DemaConsulting.ApiMark.MSBuild" Version="0.4.10" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.SysML2Tools.Tests" />
    <InternalsVisibleTo Include="DemaConsulting.SysML2Tools.Stdlib" />
    <InternalsVisibleTo Include="StdlibGen" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.302">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.30.0.144632">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
