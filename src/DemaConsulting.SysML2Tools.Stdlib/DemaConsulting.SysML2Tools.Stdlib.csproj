<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>DemaConsulting.SysML2Tools.Stdlib</PackageId>
    <AssemblyName>DemaConsulting.SysML2Tools.Stdlib</AssemblyName>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>Pre-compiled SysML v2 standard library for .NET</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/demaconsulting/SysML2Tools</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/SysML2Tools</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>sysml2;sysml;mbse;stdlib</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>SysML2 Tools Stdlib</Title>
    <Product>DemaConsulting.SysML2Tools</Product>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- ApiMark Configuration: generate Markdown API reference docs from the XML doc
         comments (see GenerateDocumentationFile above) and bundle them into the NuGet
         package alongside the assembly. -->
    <ApiMarkPackDocs>true</ApiMarkPackDocs>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(Product)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>
  </PropertyGroup>

  <!-- StdlibGen build-time tool: must complete before Stdlib compiles. Not declared as a
       ProjectReference item - see the GenerateStdlibBin target below for why. -->
  <ItemGroup>
    <ProjectReference Include="..\DemaConsulting.SysML2Tools.Language\DemaConsulting.SysML2Tools.Language.csproj" />
  </ItemGroup>

  <!-- Source files tracked for incremental build -->
  <ItemGroup>
    <StdlibSourceFiles Include="$(MSBuildThisFileDirectory)Stdlib\**\*.sysml" />
    <StdlibSourceFiles Include="$(MSBuildThisFileDirectory)Stdlib\**\*.kerml" />
  </ItemGroup>

  <!-- Generate stdlib.bin once in the outer (cross-targeting) build before inner
       TFM builds are dispatched, so all three inner TFM builds (net8.0/net9.0/net10.0)
       see an already-generated obj\stdlib.bin regardless of their internal dispatch order.
       Skipped when outputs are already up to date (incremental build).

       Uses the <MSBuild> task (not <Exec "dotnet build">) to restore+build StdlibGen. This
       runs StdlibGen's build in-process, in the SAME MSBuild engine/BuildManager session as
       the outer solution build - not a second, uncoordinated `dotnet build` process. That
       matters because StdlibGen.csproj ProjectReferences Language.csproj (net10.0), which
       is also built directly by Stdlib/Core/Tool/Tests elsewhere in the same solution
       build: within one MSBuild session, identical project+global-property build requests
       (Language.csproj, TargetFramework=net10.0) are de-duplicated and cached by the
       BuildManager, so Language.csproj is only ever compiled once and its output is safely
       reused - no second process racing to write the same obj/bin files (which previously
       caused CS2012 "file in use"), and no risk of duplicate-attribute errors from
       re-evaluating the same project with different intermediate-output overrides.

       Deliberately NOT a <ProjectReference> item: a real ProjectReference makes StdlibGen
       discoverable by other multi-targeted projects' own "GetTargetFrameworks"-style
       negotiation calls (e.g. Core.csproj resolving which of Stdlib's TFMs to reference),
       and those auxiliary, non-build evaluations build referenced projects with whatever
       default global properties they use (observed: Configuration=Debug) - independent of
       this target's own guard below. Restoring+building StdlibGen only from inside this
       explicitly guarded target (Targets="Restore;Build") keeps it invisible to every
       other build path, so it is built exactly once, always with $(Configuration).

       BuildingProject guard: BeforeTargets="PrepareForBuild" also fires during lightweight,
       non-build MSBuild evaluations of this project - e.g. the "GetTargetFrameworks"-style
       calls other multi-targeted projects (Core.csproj) make to negotiate which of
       Stdlib's TFMs to reference. Those auxiliary evaluations default Configuration to
       Debug regardless of the real build's Configuration, so without this guard the
       target would fire an extra, spurious Debug-config build of StdlibGen. $(BuildingProject)
       is only "true" for the actual Build execution, not these auxiliary evaluations. -->
  <Target Name="GenerateStdlibBin"
          BeforeTargets="DispatchToInnerBuilds;PrepareForBuild"
          Condition="'$(TargetFrameworks)' != '' AND '$(BuildingProject)' == 'true'"
          Inputs="@(StdlibSourceFiles)"
          Outputs="$(BaseIntermediateOutputPath)stdlib.bin">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Tools\StdlibGen\StdlibGen.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0" />
    <PropertyGroup>
      <_StdlibGenDll>$(MSBuildThisFileDirectory)..\Tools\StdlibGen\bin\$(Configuration)\net10.0\StdlibGen.dll</_StdlibGenDll>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(_StdlibGenDll)&quot; --stdlib-dir &quot;$(MSBuildThisFileDirectory)Stdlib&quot; --output &quot;$(BaseIntermediateOutputPath)stdlib.bin&quot;" />
  </Target>

  <!-- Embed stdlib.bin as a manifest resource in every TFM inner build.
       Guaranteed to exist because GenerateStdlibBin ran in the outer build. -->
  <Target Name="EmbedStdlibBin" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <EmbeddedResource Include="$(BaseIntermediateOutputPath)stdlib.bin">
        <LogicalName>DemaConsulting.SysML2Tools.Stdlib.stdlib.bin</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.5" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />
    <!-- ApiMark: generate Markdown API reference docs from the XML doc comments (see
         GenerateDocumentationFile above) and bundle them into this project's own NuGet
         package (see ApiMarkPackDocs above). -->
    <PackageReference Include="DemaConsulting.ApiMark.MSBuild" Version="0.4.10" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.301">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.27.0.140913">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
