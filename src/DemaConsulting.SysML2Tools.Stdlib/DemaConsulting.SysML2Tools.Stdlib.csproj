<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>DemaConsulting.SysML2Tools.Stdlib</PackageId>
    <AssemblyName>DemaConsulting.SysML2Tools.Stdlib</AssemblyName>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>Pre-compiled SysML v2 standard library for .NET</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/demaconsulting/SysML2Tools</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/SysML2Tools</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>sysml2;sysml;mbse;stdlib</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>SysML2 Tools Stdlib</Title>
    <Product>DemaConsulting.SysML2Tools</Product>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- ApiMark Configuration: generate Markdown API reference docs from the XML doc
         comments (see GenerateDocumentationFile above) and bundle them into the NuGet
         package alongside the assembly. -->
    <ApiMarkPackDocs>true</ApiMarkPackDocs>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(Product)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>
  </PropertyGroup>

  <!-- Language.csproj is a real, ordinary compile-time dependency: StdlibProvider deserializes
       the embedded stdlib data into DemaConsulting.SysML2Tools.Language.Semantic.Model types. -->
  <ItemGroup>
    <ProjectReference Include="..\DemaConsulting.SysML2Tools.Language\DemaConsulting.SysML2Tools.Language.csproj" />
  </ItemGroup>

  <!-- Pre-compiled stdlib symbol table, serialized as UTF-8 JSON and gzip-compressed,
       checked into source control and embedded as a manifest resource. StdlibProvider
       decompresses and deserializes it at runtime (lazily, once per process) - there is
       no build-time generation step here at all.

       This file is NOT generated during the solution build. It is regenerated by
       build.ps1 (as a plain, sequential pre-build step - see that script) whenever the
       stdlib source files under Stdlib\ change, and the result is committed like any
       other vendored binary asset. This deliberately avoids MSBuild-in-MSBuild
       coordination between this project and the StdlibGen tool (which previously caused
       CS2012 file-in-use races and NETSDK1005 restore-corruption errors from
       nested/recursive builds sharing the Language.csproj dependency with the outer
       solution build).

       WithCulture=false is required: MSBuild's AssignCulture task infers a resource's
       culture from its filename by splitting on '.', and "json" is not a culture code,
       but to be safe against any future rename this override guarantees the file is
       always embedded directly in the main assembly rather than being silently routed
       into a satellite-culture resources.dll (which happened previously when the file
       was named stdlib.bin.gz, since "bin" is itself a valid, if obscure, ISO 639
       culture code) - without it, StdlibProvider's GetManifestResourceStream lookup
       would fail at runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\stdlib.json.gz">
      <LogicalName>DemaConsulting.SysML2Tools.Stdlib.stdlib.json.gz</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.5" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />
    <!-- ApiMark: generate Markdown API reference docs from the XML doc comments (see
         GenerateDocumentationFile above) and bundle them into this project's own NuGet
         package (see ApiMarkPackDocs above). -->
    <PackageReference Include="DemaConsulting.ApiMark.MSBuild" Version="0.4.10" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.301">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.29.0.143774">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
